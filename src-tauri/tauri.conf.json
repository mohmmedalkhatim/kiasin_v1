{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiasin-system",
  "version": "0.1.0",
  "identifier": "com.devel.kiasin-system",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { 
        "decorations": false,
        "title": "kiasin-system",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/kiasin.ico"
    ]
  
  }

}
